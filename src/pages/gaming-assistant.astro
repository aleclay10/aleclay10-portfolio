---
import { existsSync } from 'node:fs';
import path from 'node:path';

import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';

// The hero artifact is a real screenshot in a window frame, or nothing drawn at
// all. The frame wires itself up the moment Alec's files land in
// public/gaming-assistant/ (see DeviceFrame.astro for the four names); until
// then the hero shows the four engineering facts as a quiet spec block. The
// illustrative sketch that used to sit here was the one dishonest artifact on
// the site and is gone for good.
const shots = path.resolve(process.cwd(), 'public/gaming-assistant');
const hasScreenshots = ['light.webp', 'light.png', 'dark.webp', 'dark.png'].every((f) => existsSync(path.join(shots, f)));
// Alec writes the alt text when the screenshots land.
const screenshotAlt = 'AI Gaming Assistant: the chat and session panes beside a running game';

const title = 'AI Gaming Assistant · early access';
const description =
	'A lightweight desktop companion for gamers: AI chat with play-history context, session tracking, and Discord without alt-tabbing. Early access.';

const labelClass =
	'mb-1.5 block font-mono t-caption uppercase tracking-[0.14em] text-muted';
const fieldClass =
	'w-full rounded-md border border-line bg-canvas px-3.5 py-2.5 font-mono text-base text-ink placeholder:text-muted focus:border-accent sm:t-footnote';

// One entry per no-JS failure class. The Worker redirects each failure to
// /gaming-assistant?e=<code>#w-err-<code>; CSS :target reveals the matching block
// below with no script involved, and the page script uses the same text for the
// live region before removing the block. Keep the codes in step with retryPath()
// in waitlist-worker/src/index.ts, and never collapse these into one message.
const failures = [
	{
		code: 'invalid',
		text: 'Something in that submission did not pass the checks. Look over the fields and try again.',
	},
	{
		code: 'rate',
		text: 'Too many attempts in a row. Wait a minute, then try once more.',
	},
	{
		code: 'server',
		text: 'Something went wrong on my end. Nothing was saved. Try again in a moment.',
	},
];

const features = [
	{
		label: 'AI chat that knows your games',
		desc: 'Streamed answers with your play history as context: builds, strats, lore, whatever the session calls for.',
	},
	{
		label: 'Session tracking',
		desc: 'Detects 80+ titles automatically and keeps your play log local-first, synced to the cloud when you want it.',
	},
	{
		label: 'Discord, without alt-tab',
		desc: 'Read and answer DMs from inside the companion. No more dropping out of a match to check your phone.',
	},
	{
		label: 'Content briefings',
		desc: 'Your subreddits, feeds, and channels distilled into a "what you missed" brief between sessions.',
	},
	{
		label: 'Notifications with game sense',
		desc: 'A priority queue that knows when you’re mid-match. Only the urgent breaks through; the rest waits.',
	},
	{
		label: 'Stats & weekly recap',
		desc: 'Playtime across every title you touch, plus an AI-written recap of your week in games.',
	},
];

// Reading sentences in Inter, with the product names inside them in mono.
const engineering: { name: string; note: string }[] = [
	{ name: 'Tauri 2 + Rust', note: 'core: megabytes on disk, not an Electron heavyweight' },
	{ name: 'SQLite', note: 'local-first; cloud sync is opt-in, with retry and token refresh' },
	{ name: 'Groq → Together AI → Ollama', note: 'the inference chain, cloud or your own machine, your choice' },
	{ name: '238 tests', note: 'automated, across Rust, Python, and TypeScript' },
];

// The hero's spec block until the screenshots land: same four facts, as data.
const specBlock = [
	['core', 'Tauri 2 + Rust'],
	['storage', 'local-first SQLite'],
	['inference', 'Groq → Together → Ollama'],
	['tests', '238 across Rust, Python, TS'],
];

const tiers = [
	{
		name: 'Free',
		price: '$0',
		cadence: 'forever',
		items: ['50 AI messages a day', 'Session tracking, all titles', 'Discord viewing', 'Content feed & stats'],
	},
	{
		name: 'Pro',
		price: '$2.99',
		cadence: 'per month',
		featured: true,
		items: ['Unlimited AI chat', 'Send & reply on Discord', 'Priority inference', 'Weekly AI recap'],
	},
];
---

<Base title={title} description={description}>
	<main id="main-content" tabindex="-1" class="flex flex-1 flex-col py-16">
		<!-- Hero. One column: title, intro, the one primary action, then the
		     artifact, which shows on phones too (the old sketch was hidden there). -->
		<div class="reveal max-w-2xl">
			<p class="font-mono t-footnote uppercase tracking-[0.2em] text-muted">
				Product · Early access
			</p>
			<h1 class="mt-5 font-serif t-display font-medium tracking-tight text-ink">
				Game on.<br /><span class="italic text-accent">Phone down.</span>
			</h1>
			<p class="mt-7 t-body text-body">
				AI Gaming Assistant is a lightweight desktop companion that lives alongside
				your games. It learns what you play, keeps you connected, and handles
				everything you'd otherwise reach for your phone to do mid-session.
			</p>
			<div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-3 font-mono t-footnote">
				<a href="#waitlist" class="rounded-md bg-accent px-4 py-2.5 font-medium text-canvas transition hover:opacity-90">
					Get early access
				</a>{' '}
				<span class="px-2 py-2.5 text-muted">Windows & macOS at launch · free tier included</span>
			</div>
		</div>

		<div class="reveal reveal-2 mt-12">
			{hasScreenshots ? (
				<DeviceFrame base="/gaming-assistant/" alt={screenshotAlt} width={1600} height={1000} />
			) : (
				<dl class="max-w-md divide-y divide-line border-y border-line font-mono t-caption">
					{specBlock.map(([k, v]) => (
						<div class="flex items-baseline justify-between gap-x-3 py-2">
							<dt class="text-muted">{k}</dt>
							<dd class="text-ink">{v}</dd>
						</div>
					))}
				</dl>
			)}
		</div>

		<!-- Features -->
		<section id="features" class="mt-20 border-t border-line pt-10">
			<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">What it does</h2>
			<div class="mt-5 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
				{features.map((f) => (
					<div class="bg-canvas p-5">
						<h3 class="font-serif t-title3 text-ink">{f.label}</h3>
						<p class="mt-2 t-subhead leading-relaxed text-body">{f.desc}</p>
					</div>
				))}
			</div>
		</section>

		<!-- Engineering strip -->
		<section class="mt-16 grid gap-10 border-t border-line pt-10 sm:grid-cols-[1fr_1.5fr]">
			<div>
				<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">Built like it means it</h2>
				<p class="mt-3 max-w-xs t-subhead leading-relaxed text-body">
					The same engineering bar as everything else on this site: small,
					fast, local-first, and tested.
				</p>
			</div>
			<ul class="space-y-2.5 t-subhead leading-relaxed text-body sm:mt-1">
				{engineering.map((e) => (
					<li class="flex items-baseline gap-x-2.5">
						<span class="h-1.5 w-1.5 shrink-0 self-center rounded-full bg-muted"></span>
						<span><span class="font-mono text-ink">{e.name}</span>{' '}{e.note}</span>
					</li>
				))}
			</ul>
		</section>

		<!-- Pricing -->
		<section id="pricing" class="mt-16 border-t border-line pt-10">
			<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">Pricing</h2>
			<div class="mt-5 grid gap-5 sm:max-w-2xl sm:grid-cols-2">
				{tiers.map((t) => (
					<div class={`rounded-xl border p-6 ${t.featured ? 'border-accent' : 'border-line'}`}>
						<div class="flex items-baseline justify-between">
							<h3 class="font-serif t-title3 text-ink">{t.name}</h3>
							<p class="font-mono t-footnote text-muted">
								<span class="text-lg font-medium text-ink">{t.price}</span> {t.cadence}
							</p>
						</div>
						<ul class="mt-5 space-y-2.5 t-subhead leading-relaxed text-body">
							{t.items.map((i) => (
								<li class="flex items-baseline gap-x-2.5">
									<span class={`h-1.5 w-1.5 shrink-0 self-center rounded-full ${t.featured ? 'bg-accent' : 'bg-line'}`}></span>
									{i}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
			<p class="mt-4 font-mono t-caption text-muted">Billing will run in-app through Stripe at launch; no card needed for early access now.</p>
		</section>

		<!-- Privacy -->
		<section id="privacy" class="mt-16 border-t border-line pt-10">
			<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">Your data</h2>
			<p class="mt-3 max-w-2xl t-callout leading-relaxed text-body">
				Local-first by design: your play history lives on your machine and syncs only
				if you opt in. On the default cloud inference tiers, whatever you send the AI
				chat (including play history used as context) passes through that
				provider (Groq or Together AI) to generate a response; switch to the local
				Ollama option to keep inference fully on-device. Anything the app collects is
				consent-based and spelled out at onboarding: no dark patterns, no selling
				data.
			</p>
		</section>

		<!-- Waitlist -->
		<section id="waitlist" class="mt-16 border-t border-line pt-10">
			<p class="font-mono t-caption uppercase tracking-[0.2em] text-muted">Early access</p>
			<h2 class="mt-4 font-serif text-3xl font-medium tracking-tight text-ink">Be first through the door.</h2>
			<p class="mt-3 max-w-md t-callout leading-relaxed text-body">
				Windows and macOS builds land soon. Join the list and you'll hear the moment
				the doors open. Nothing else, no spam.
			</p>

			{/* No-JS failure messages, one per class, revealed by CSS :target when the
			    Worker's redirect fragment points at them. The Back-button line is real:
			    session history still holds the submitted values on a plain form POST.
			    data-search-skip on every block element because isSkipped() does not
			    cascade; an error string must not surface in a ⌘K search. */}
			{failures.map((f) => (
				<div
					id={`w-err-${f.code}`}
					data-search-skip
					class="mt-6 hidden max-w-md rounded-md border border-accent/60 p-4 font-mono t-caption leading-relaxed target:block"
				>
					<p class="text-ink" data-search-skip>{f.text}</p>
					<p class="mt-2 text-muted" data-search-skip>
						What you typed is still in the form if you use your browser's Back button.
					</p>
				</div>
			))}

			<form
				id="waitlist-form"
				method="post"
				action="/api/waitlist"
				class="mt-7 max-w-md space-y-4"
			>
				<div class="grid gap-4 sm:grid-cols-2">
					<div>
						<label for="first_name" class={labelClass}>First name</label>
						<input id="first_name" name="first_name" type="text" required maxlength="80"
							autocomplete="given-name" class={fieldClass} />
					</div>
					<div>
						<label for="last_name" class={labelClass}>Last name</label>
						<input id="last_name" name="last_name" type="text" required maxlength="80"
							autocomplete="family-name" class={fieldClass} />
					</div>
				</div>

				<div>
					<label for="email" class={labelClass}>Email</label>
					<input id="email" name="email" type="email" required maxlength="254"
						autocomplete="email" placeholder="you@example.com" class={fieldClass} />
				</div>

				<div>
					<label for="notes" class={labelClass}>
						Anything I should know? <span class="normal-case tracking-normal text-faint">optional</span>
					</label>
					<textarea id="notes" name="notes" rows="3" maxlength="2000"
						placeholder="What you play, what you'd want it to do…"
						class={`${fieldClass} resize-y`}></textarea>
				</div>

				{/* Honeypot. Hidden from sight, the a11y tree and the tab order — anything
				    that fills it in is automated, and the server discards the submission
				    while still reporting success. Named gamer_tag, NOT anything in the
				    browsers' autofill vocabulary: the previous name, company, is Chrome's
				    "organization" heuristic and Chrome ignores autocomplete="off", so a
				    real visitor's autofill could have tripped it and silently lost the
				    signup. Keep the name in step with HONEYPOT_FIELDS in the Worker. */}
				<div class="hidden" aria-hidden="true">
					<label for="gamer_tag">Leave this field empty</label>
					<input id="gamer_tag" name="gamer_tag" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div class="flex flex-wrap items-center gap-x-4 gap-y-2 pt-1">
					<button type="submit" id="waitlist-submit"
						class="rounded-md bg-accent px-4 py-2.5 font-mono t-footnote font-medium text-canvas transition hover:opacity-90 disabled:opacity-60">
						Request early access
					</button>
					<p id="waitlist-message" role="status" aria-live="polite"
						class="font-mono t-caption leading-relaxed text-muted"></p>
				</div>
			</form>

			{/* Success announcements land here, not in #waitlist-message: that region
			    lives inside the form, and the success path replaces the form wholesale,
			    which would destroy the region mid-announcement. This one is outside the
			    swap and visually hidden; sighted users read the inserted card instead. */}
			<p id="waitlist-announce" role="status" aria-live="polite" class="sr-only"></p>

			<p class="mt-4 font-mono t-caption leading-relaxed text-muted">
				Your address is stored so I can tell you when builds are ready. Nothing else,
				never sold, and every message will carry an unsubscribe link.
			</p>
		</section>
	</main>
</Base>

<script>
	// Progressive enhancement for the early-access form.
	//
	// The form works with no JavaScript at all: it is a native POST to /api/waitlist,
	// and the Worker answers a no-JS submission with a 303 to /gaming-assistant/thanks.
	// Everything below only upgrades that to an inline result with no page navigation.
	//
	// Every failure path falls back to the native submit rather than showing a broken
	// widget — same rule as UptimeChip.astro, where a failed fetch leaves the static
	// markup untouched. The one thing this must never do is swallow a submission.

	const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
	const button = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
	const message = document.getElementById('waitlist-message');
	const announcer = document.getElementById('waitlist-announce');

	// Written just before handing a failed fetch back to the native form POST, read
	// back when the Worker's error redirect returns here. sessionStorage because the
	// draft should survive the round trip but not the tab.
	const DRAFT_KEY = 'waitlist-draft';
	const FIELDS = ['first_name', 'last_name', 'email', 'notes'] as const;

	// Must match the copy in the static #w-err-* blocks above, which cover the same
	// codes for no-JS visitors. Unknown codes (including a stale ?e=1 from a Worker
	// version behind this page) fall back to the generic line.
	const failureMessages: Record<string, string> = {
		invalid: 'Something in that submission did not pass the checks. Look over the fields and try again.',
		rate: 'Too many attempts in a row. Wait a minute, then try once more.',
		server: 'Something went wrong on my end. Nothing was saved. Try again in a moment.',
	};

	function say(text: string, tone: 'error' | 'muted' = 'error') {
		if (!message) return;
		message.textContent = text;
		message.classList.toggle('text-accent', tone === 'error');
		message.classList.toggle('text-muted', tone === 'muted');
	}

	// The no-JS error path redirects back here with ?e=<code>. Surface the matching
	// message through the live region, drop the CSS :target block so the same text is
	// not shown twice, restore anything stashed before a native-fallback POST, then
	// strip the parameter so a reload or a shared link does not resurface a stale
	// error.
	const failureCode = new URLSearchParams(location.search).get('e');
	if (form && failureCode !== null) {
		say(failureMessages[failureCode] ?? 'Something in that submission did not go through. Give it another try?');
		document.getElementById(`w-err-${failureCode}`)?.remove();
		try {
			const draft = sessionStorage.getItem(DRAFT_KEY);
			if (draft) {
				const values = JSON.parse(draft) as Partial<Record<string, string>>;
				for (const field of FIELDS) {
					const input = form.elements.namedItem(field);
					if (
						(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) &&
						typeof values[field] === 'string'
					) {
						input.value = values[field];
					}
				}
				sessionStorage.removeItem(DRAFT_KEY);
			}
		} catch {
			// Storage unavailable (private mode, quota). The error message still shows;
			// only the repopulation is lost.
		}
		const url = new URL(location.href);
		url.searchParams.delete('e');
		history.replaceState(null, '', url.pathname + url.search + url.hash);
	}

	form?.addEventListener('submit', async (event) => {
		if (!form.reportValidity()) return;
		event.preventDefault();

		const data = new FormData(form);
		const payload = {
			first_name: String(data.get('first_name') ?? ''),
			last_name: String(data.get('last_name') ?? ''),
			email: String(data.get('email') ?? ''),
			notes: String(data.get('notes') ?? ''),
			gamer_tag: String(data.get('gamer_tag') ?? ''),
		};

		if (button) {
			button.disabled = true;
			button.textContent = 'Sending…';
		}
		// Real feedback for the live region, not a wipe: clearing the region here is
		// what left the whole submission unannounced to screen readers.
		say('Sending…', 'muted');

		let res: Response;
		try {
			res = await fetch(form.action, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(payload),
			});
		} catch {
			// Offline, blocked, or the edge is unreachable. Hand the submission back to
			// the browser: a full-page POST may still succeed, and if it does not the
			// user gets the browser's own error rather than a silently dead button.
			// Stash the typed values first so the ?e= handler above can restore them if
			// the Worker bounces the native POST back here. Never the honeypot field:
			// restoring that would trip the trap on the retry.
			try {
				sessionStorage.setItem(
					DRAFT_KEY,
					JSON.stringify({
						first_name: payload.first_name,
						last_name: payload.last_name,
						email: payload.email,
						notes: payload.notes,
					})
				);
			} catch {
				// Storage unavailable; the native POST still goes out.
			}
			form.submit();
			return;
		}

		if (button) {
			button.disabled = false;
			button.textContent = 'Request early access';
		}

		if (res.ok) {
			try {
				sessionStorage.removeItem(DRAFT_KEY);
			} catch {
				// Nothing stashed, or storage unavailable. Either way done.
			}
			const done = document.createElement('div');
			done.className = 'mt-7 max-w-md rounded-xl border border-accent p-5 focus:outline-none';
			// No role="status" here: a live region announces changes to content it
			// already had, so text arriving together with a brand-new node is read by
			// nothing. The pre-existing #waitlist-announce region does the announcing;
			// moving focus onto the card covers it a second way and fixes focus
			// otherwise dropping to <body> when the form disappears under it.
			done.tabIndex = -1;
			done.innerHTML =
				'<p class="font-mono t-caption uppercase tracking-[0.14em] text-accent">You’re on the list</p>' +
				'<p class="mt-2 t-callout leading-relaxed text-body">' +
				'I’ll email you the moment there’s a build worth your time. Nothing before then.</p>';
			form.replaceWith(done);
			if (announcer) {
				announcer.textContent =
					'You’re on the list. I’ll email you the moment there’s a build worth your time.';
			}
			done.focus();
			return;
		}

		if (res.status === 429) {
			say('That’s a few too many tries in a row. Give it a minute.');
			return;
		}

		const problem = await res.json().catch(() => null);
		const detail =
			problem && typeof problem === 'object' && typeof (problem as { error?: unknown }).error === 'string'
				? (problem as { error: string }).error
				: 'Something went wrong on my end. Try again in a moment?';
		say(detail);
	});
</script>
