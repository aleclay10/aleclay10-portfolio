---
// Confirmation for feedback submitted WITHOUT JavaScript. The Worker answers a
// native form POST with a 303 here, so the no-JS path lands somewhere fully
// site-styled. Visitors with JavaScript never get here: the enhanced path swaps
// in an inline result without navigating. Hence noindex.
import Base from '../../layouts/Base.astro';
import Penguin from '../../components/Penguin.astro';

const title = 'Feedback · filed';
const description = 'Your note about this site reached Alec.';
---

<Base title={title} description={description} noindex mascot={false}>
	<main class="flex flex-1 flex-col py-16">
		<div class="flex items-start gap-8">
			<div class="max-w-2xl">
				<p class="font-mono t-footnote uppercase tracking-[0.2em] text-muted">Feedback · filed</p>
				<h1 class="mt-5 font-serif t-title1 font-medium tracking-tight text-ink">Filed.</h1>
				<p class="mt-7 t-body leading-relaxed text-body">
					Alec reads every one of these himself. If he has a question about yours, he will
					write back to the address you left, and that is the only thing it will be used for.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-3 font-mono t-footnote">
					<a href="/" class="rounded-md bg-accent px-4 py-2.5 font-medium text-canvas transition hover:opacity-90">
						Back to the site
					</a>
				</div>
			</div>
			<Penguin class="hidden w-28 shrink-0 sm:block" />
		</div>
	</main>
</Base>
