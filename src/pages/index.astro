---
import Base from '../layouts/Base.astro';

const title = 'Alec Layton — Autonomous agent systems';
const description =
	'Alec Layton — I build autonomous agent systems. Projects, writing, and experiments in AI infrastructure.';

const eras: { years: string; title: string; org: string; desc: string; tag: string; current?: boolean; href?: string; linkText?: string }[] = [
	{
		years: '2021',
		title: 'Enterprise Architect Developer',
		org: 'Valero Energy · San Antonio, TX',
		desc: 'Fortune 500 internship in the SAP machine room — built the ABAP app that carried Accounts Payable for 90% of U.S. transactions.',
		tag: 'Energy',
	},
	{
		years: 'Dec 2022',
		title: 'B.S. Computer Science',
		org: 'UT San Antonio',
		desc: 'Software engineering & data science concentrations. Deep-learning vulnerability research with the grad lab; ACM ICPC for sport.',
		tag: 'Education',
	},
	{
		years: 'Dec 2022 →',
		title: 'Software Engineer',
		org: 'Paycom · Irving, TX',
		desc: 'Compliance-critical payroll systems moving hundreds of millions a year — multi-country tax API internationalization, and ETL automation that erased 100+ manual hours a quarter.',
		tag: 'FinTech',
		current: true,
	},
	{
		years: '2025',
		title: 'AI Gaming Assistant',
		org: 'Independent',
		desc: 'Full-stack desktop companion — React/TypeScript on a Rust (Tauri) core with FastAPI, Postgres, and Redis — routing AI inference to cloud or local models.',
		tag: 'Product',
		href: '/gaming-assistant',
		linkText: 'See the product →',
	},
	{
		years: '2026',
		title: 'The agents era',
		org: 'Kowalski · this site',
		desc: 'Built an autonomous agent to run my day, then handed it the keys to this Mac mini. It ships pages here now — including its own.',
		tag: 'AI agents',
		current: true,
		href: '/kowalski',
		linkText: 'Meet Kowalski →',
	},
];

const projects: { n: string; name: string; desc: string; tag: string; href?: string }[] = [
	{ n: '01', name: 'AI Gaming Assistant', desc: 'Desktop gaming companion — AI chat, play tracking, Discord in-game. Early access.', tag: 'Product', href: '/gaming-assistant' },
	{ n: '02', name: 'Kowalski', desc: 'Autonomous personal-ops agent — calendar, mail, vault, code.', tag: 'AI agents', href: '/kowalski' },
	{ n: '03', name: 'Self-hosted platform', desc: 'Mac mini + Cloudflare Tunnel — git push to live, zero open ports.', tag: 'Infra' },
];
---

<Base title={title} description={description}>
	<!-- Hero -->
	<main data-pagefind-body class="flex flex-1 flex-col justify-center py-16">
		<div class="grid items-center gap-12 sm:grid-cols-[1.5fr_1fr]">
			<div class="reveal">
				<p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
					Software engineer · AI agent systems
				</p>
				<h1 class="mt-5 font-serif text-5xl font-medium leading-[0.98] tracking-tight text-ink sm:text-7xl"
					style="font-optical-sizing: auto;">
					I build<br />autonomous<br /><span class="italic text-accent">agent systems.</span>
				</h1>
				<p class="mt-7 max-w-md text-[17px] leading-relaxed text-muted">
					I design and ship AI tooling and the infrastructure under it — including
					<a href="/kowalski" class="text-ink underline decoration-line underline-offset-4 transition hover:text-accent hover:decoration-accent">Kowalski</a>,
					an autonomous agent that runs my day. This site is self-hosted
					on a Mac mini in my apartment, served over a Cloudflare tunnel.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-3 font-mono text-[13px]">
					<a href="#projects" class="rounded-md bg-accent px-4 py-2.5 font-medium text-canvas transition hover:opacity-90">
						View projects
					</a>
					<a href="/resume" class="rounded-md border border-line px-4 py-2.5 font-medium text-ink transition hover:border-accent hover:text-accent">
						Résumé
					</a>
					<a href="https://github.com/aleclay10" class="link px-2 py-2.5">GitHub ↗</a>
					<a href="mailto:alec.layton100@gmail.com" class="link px-2 py-2.5">Email ↗</a>
				</div>
			</div>

			<!-- Portrait. public/alec.webp is 512x640 (2x the 256px slot), metadata stripped. -->
			<div class="reveal reveal-2 justify-self-center sm:justify-self-end">
				<div class="relative aspect-[4/5] w-56 overflow-hidden rounded-2xl border border-line bg-surface sm:w-64">
					<img src="/alec.webp" alt="Alec Layton" width="512" height="640"
						decoding="async" fetchpriority="high"
						class="h-full w-full object-cover" />
					<div class="absolute inset-x-0 bottom-0 flex items-center gap-x-2 border-t border-line bg-canvas/70 px-3 py-2 font-mono text-[11px] text-muted backdrop-blur">
						<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
						Currently building · agents + infra
					</div>
				</div>
			</div>
		</div>
	</main>

	<!-- Timeline carousel -->
	<section id="timeline" class="border-t border-line py-10">
		<div class="flex items-center justify-between">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Timeline</p>
			<div class="hidden items-center gap-x-2 sm:flex">
				<button id="tl-prev" type="button" aria-label="Scroll timeline back"
					class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
				</button>
				<button id="tl-next" type="button" aria-label="Scroll timeline forward"
					class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
				</button>
			</div>
		</div>
		<ul id="tl-rail" tabindex="0" aria-label="Career timeline, scroll horizontally"
			class="no-scrollbar mt-6 flex snap-x snap-mandatory gap-x-5 overflow-x-auto pb-2">
			{eras.map((e) => (
				<li class="flex w-[78vw] max-w-[360px] shrink-0 snap-start flex-col sm:w-[360px]">
					<div class="flex items-center gap-x-3">
						<span class={`h-2 w-2 shrink-0 rounded-full ${e.current ? 'bg-accent' : 'border border-line bg-surface'}`}></span>
						<span class="font-mono text-[12px] uppercase tracking-wider text-muted">{e.years}</span>
						<span class="h-px min-w-4 flex-1 bg-line"></span>
						<span class="font-mono text-[11px] uppercase tracking-wider text-muted">{e.tag}</span>
					</div>
					<div class="mt-4 flex-1 rounded-xl border border-line bg-surface/40 p-5 transition hover:border-accent/40">
						<h3 class="font-serif text-xl text-ink">{e.title}</h3>
						<p class="mt-0.5 font-mono text-[12px] text-muted">{e.org}</p>
						<p class="mt-3 text-[14px] leading-relaxed text-muted">{e.desc}</p>
						{e.href && (
							<a href={e.href} class="link mt-4 inline-block font-mono text-[13px]">{e.linkText ?? 'More →'}</a>
						)}
					</div>
				</li>
			))}
		</ul>
		<!-- Bundled (not is:inline) on purpose: the production CSP blocks inline scripts. -->
		<script>
			(() => {
				const rail = document.getElementById('tl-rail');
				if (!rail) return;
				const step = () => ((rail.querySelector('li')?.getBoundingClientRect().width ?? 340) + 20);
				const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
				document.getElementById('tl-prev')?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior }));
				document.getElementById('tl-next')?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior }));
			})();
		</script>
	</section>

	<!-- Projects teaser strip -->
	<section id="projects" class="border-t border-line py-10">
		<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Selected work</p>
		<ul class="mt-6 divide-y divide-line">
			{projects.map((p) => (
				<li class="group relative flex items-baseline gap-x-5 py-4 transition">
					<span class="font-mono text-[12px] text-muted">{p.n}</span>
					<div class="flex-1">
						<h3 class="font-serif text-xl text-ink transition group-hover:text-accent">
							{p.href ? (
								<a href={p.href} class="after:absolute after:inset-0">
									{p.name}
									<span aria-hidden="true" class="ml-1 inline-block font-mono text-[14px] text-muted transition group-hover:translate-x-0.5 group-hover:text-accent">→</span>
								</a>
							) : (
								p.name
							)}
						</h3>
						<p class="mt-1 max-w-lg text-[14px] leading-relaxed text-muted">{p.desc}</p>
					</div>
					<span class="hidden font-mono text-[11px] uppercase tracking-wider text-muted sm:block">{p.tag}</span>
				</li>
			))}
		</ul>
	</section>
</Base>
