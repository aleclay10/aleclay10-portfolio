---
import Base from '../layouts/Base.astro';

const title = 'Now · what I’m doing';
const description = 'What Alec Layton is focused on right now: shipping AI Gaming Assistant, building Kowalski, and payroll systems at Paycom.';

// A /now page is only worth having if it is current: nownownow.com, which this
// page links to, exists to make exactly that point. Bump this whenever the list
// below stops being true.
const updated = 'August 24, 2026';

const focus = [
	{
		title: 'Shipping AI Gaming Assistant',
		desc: 'The early-access waitlist is open. Next up: Windows and macOS installers, the release pipeline, and getting builds into the first testers’ hands.',
		href: '/gaming-assistant/',
	},
	{
		title: 'Building Kowalski in public',
		desc: 'My autonomous agent keeps gaining capabilities. It runs my calendar, mail, security scans, and writes most of this site: it opens the pull requests, I sign the release.',
		href: '/kowalski/',
	},
	{
		title: 'Payroll systems at Paycom',
		desc: 'The day job: compliance-critical software moving hundreds of millions a year, where "mostly correct" is not a category.',
	},
	{
		title: 'Running this site off a Mac mini',
		desc: 'Self-hosted everything, now released only by signed tag. The infrastructure is the hobby.',
		href: '/stack/',
	},
];
---

<Base title={title} description={description}>
	<main id="main-content" tabindex="-1" class="flex flex-1 flex-col py-16">
		<div class="reveal max-w-2xl">
			<p class="font-mono t-footnote uppercase tracking-[0.2em] text-muted">Now</p>
			<!-- Quiet title: no italic accent tail. That moment belongs to the home hero
			     and the product pages; repeated on every utility page it stopped being one. -->
			<h1 class="mt-5 font-serif t-title1 font-medium tracking-tight text-ink">
				What I'm on right now.
			</h1>
			<p class="mt-7 font-mono t-footnote text-muted">Updated {updated} · the <a href="https://nownownow.com/about" class="link underline decoration-line underline-offset-4">/now page</a> convention</p>
		</div>

		<!-- The only section on the site with no eyebrow to label it, so the search
		     indexer is told explicitly rather than warning on every block in it. -->
		<section data-search-section="Focus" class="reveal reveal-2 mt-14">
			<ul class="max-w-2xl divide-y divide-line">
				{focus.map((f) => (
					<li class="py-5">
						<h2 class="font-serif t-title3 text-ink">
							{f.href ? <a href={f.href} class="transition hover:text-accent">{f.title} →</a> : f.title}
						</h2>
						<p class="mt-1.5 max-w-lg t-subhead leading-relaxed text-body">{f.desc}</p>
					</li>
				))}
			</ul>
		</section>
	</main>
</Base>
