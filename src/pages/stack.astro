---
import Base from '../layouts/Base.astro';

const title = '/stack — how this site works';
const description =
	'The full stack behind aleclay10.dev: Astro on a Mac mini in an apartment, zero open ports, git-push deploys, and an AI agent that ships the pages.';

const pipeline = [
	{ step: 'git push', note: 'to main — that’s the whole deploy ceremony' },
	{ step: 'launchd poller', note: 'checks origin every 60s from the Mac mini' },
	{ step: 'npm ci · astro build', note: 'reproducible build, static output only' },
	{ step: 'rsync → Caddy', note: 'atomic swap into the web root, loopback-only server' },
	{ step: 'Cloudflare Tunnel', note: 'outbound-only connection — zero open inbound ports' },
	{ step: 'edge cache purge', note: 'scoped API token, purge-only, auto after deploy' },
	{ step: 'you', note: 'TLS at the edge, HTML always fresh' },
];

const stack = [
	{ label: 'Framework', value: 'Astro 7, static output, ~0 JS shipped by default' },
	{ label: 'Styling', value: 'Tailwind CSS v4, CSS-first config, semantic tokens for the dual theme' },
	{ label: 'Type', value: 'Fraunces · Inter · JetBrains Mono — all self-hosted, no third-party requests' },
	{ label: 'Search', value: 'A ~9 KB JSON index built at deploy time — find-in-files across every page, no WASM, no third-party script' },
	{ label: 'Hardware', value: 'Apple M4 Mac mini, 16 GB, in my apartment — wildly overqualified' },
	{ label: 'Server', value: 'Caddy on loopback only; hardened headers, hidden dotfiles' },
	{ label: 'Network', value: 'Cloudflare Tunnel + DNS + TLS; home IP never exposed' },
	{ label: 'Ops', value: 'Health check every 5 min, daily log rotation, append-only run history' },
];
---

<Base title={title} description={description}>
	<main class="flex flex-1 flex-col py-16">
		<div class="reveal max-w-2xl">
			<p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">Colophon</p>
			<h1 class="mt-5 font-serif text-5xl font-medium leading-[0.98] tracking-tight text-ink sm:text-6xl"
				style="font-optical-sizing: auto;">
				How this site <span class="italic text-accent">works.</span>
			</h1>
			<p class="mt-7 text-[17px] leading-relaxed text-muted">
				No Vercel, no Netlify, no cloud hosting bill. This site is built, served, and
				operated end-to-end on hardware I own — and most of its pages were shipped by{' '}
				<a href="/kowalski" class="text-ink underline decoration-line underline-offset-4 transition hover:text-accent hover:decoration-accent">Kowalski</a>,
				my AI agent, through pull requests I review.
			</p>
		</div>

		<!-- Deploy pipeline -->
		<section class="reveal reveal-2 mt-16 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">The pipeline</p>
			<ol class="mt-6 max-w-2xl">
				{pipeline.map((p, i) => (
					<li class="flex gap-x-4">
						<div class="flex flex-col items-center">
							<span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${i === pipeline.length - 1 ? 'bg-accent' : 'border border-line bg-surface'}`}></span>
							{i < pipeline.length - 1 && <span class="w-px flex-1 bg-line"></span>}
						</div>
						<div class="pb-6">
							<p class="font-mono text-[13px] font-medium text-ink">{p.step}</p>
							<p class="mt-0.5 text-[13px] leading-relaxed text-muted">{p.note}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		<!-- Stack table -->
		<section class="mt-10 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">The parts</p>
			<dl class="mt-6 max-w-2xl divide-y divide-line">
				{stack.map((s) => (
					<div class="grid gap-x-6 py-3.5 sm:grid-cols-[8rem_1fr]">
						<dt class="font-mono text-[12px] uppercase tracking-wider text-muted">{s.label}</dt>
						<dd class="mt-1 text-[14px] leading-relaxed text-ink sm:mt-0">{s.value}</dd>
					</div>
				))}
			</dl>
		</section>

		<!-- Security -->
		<section class="mt-10 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Security posture</p>
			<div class="mt-6 max-w-2xl space-y-4 text-[15px] leading-relaxed text-muted">
				<p>
					Zero inbound ports — the tunnel dials out, nothing dials in. The web server
					binds to loopback and serves static files with a strict Content-Security-Policy,
					which is exactly as unforgiving as it sounds: it once silently blocked this
					site's own theme toggle for weeks because the script was inlined. Everything
					executable is now an external, same-origin file. Lesson kept.
				</p>
				<p>
					A scheduled agent audits the machine daily against a security baseline —
					drift gets flagged to a human, never auto-accepted.
				</p>
			</div>
		</section>

		<!-- The agent -->
		<section class="mt-10 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">The unusual part</p>
			<p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-muted">
				The pages on this site are largely written, verified, and pushed by{' '}
				<a href="/kowalski" class="text-ink underline decoration-line underline-offset-4 transition hover:text-accent hover:decoration-accent">an autonomous agent</a>{' '}
				running on the same Mac mini that serves them. It opens branches, runs the
				checks, and hands me a pull request — merging is the only button I press.
			</p>
		</section>
	</main>
</Base>
