---
import Base from '../layouts/Base.astro';
import AllocationDonut from '../components/AllocationDonut.astro';
import PageNav from '../components/PageNav.astro';
import { vectors, holdings, principles, watchlist, baselineAsOf, layers, layerLabel } from '../data/portfolio';

const title = 'Investing · how and why I invest';
const description =
	'The thesis behind my brokerage and crypto book: allocation by conviction vector, live prices, and the rules behind every add and exit.';

// Baseline "as of" for the server-rendered weights. Live prices override the
// numbers client-side; this date describes the fallback, not the live feed.
const asOf = baselineAsOf;

// Right-column section list. Ids must match the sections below.
const onThisPage = [
	{ href: '#performance', label: 'Performance' },
	{ href: '#theses', label: 'The theses' },
	{ href: '#positions', label: 'Positions' },
	{ href: '#watchlist', label: 'Watchlist' },
	{ href: '#rules', label: 'The rules' },
];

const byVector = vectors.map((v) => ({
	...v,
	holdings: holdings.filter((h) => h.vector === v.id).sort((a, b) => b.weight - a.weight),
	weight: holdings.filter((h) => h.vector === v.id).reduce((s, h) => s + h.weight, 0),
}));

const sorted = [...holdings].sort((a, b) => b.weight - a.weight);
const slotOf = (id: string) => vectors.find((v) => v.id === id)?.slot ?? 1;
const labelOf = (id: string) => vectors.find((v) => v.id === id)?.label ?? id;

// Thesis-card ticker line. A layered vector lists its holdings by layer so the
// card itself answers "why is a power utility in here"; the rest stay a flat list.
const tickerLine = (hs: typeof holdings) => {
	const layered = layers
		.map((l) => ({ label: l.label, tickers: hs.filter((h) => h.layer === l.id).map((h) => h.ticker) }))
		.filter((l) => l.tickers.length);
	return layered.length
		? layered.map((l) => `${l.label} ${l.tickers.join(', ')}`).join(' · ')
		: hs.map((h) => h.ticker).join(' · ');
};
---

<Base title={title} description={description}>
	<main id="main-content" tabindex="-1" class="viz-root flex flex-1 flex-col py-16 lg:grid lg:grid-cols-[minmax(0,1fr)_10rem] lg:gap-x-16">
		<div class="min-w-0">
		<!-- Hero -->
		<div class="reveal max-w-2xl">
			<p class="font-mono t-footnote uppercase tracking-[0.2em] text-muted">Investing</p>
			<!-- The compact cap is not decoration. "Concentration," is one unbreakable
			     14-character word; at Display's 3rem it measures wider than a 320px
			     viewport, and wider than 390px once the visitor's text size is at 150%,
			     so it pushed the whole document sideways. Below sm the size is the
			     smaller of 3rem and 11.25vw: 36px at 320, 44px at 390, 48px from 427 up,
			     and the vw half cannot grow with the text-size setting. Every other h1
			     on the site has a short enough first word to fit, which is why this is
			     here and not in the shared style. -->
			<h1
				class="mt-5 font-serif t-display font-medium tracking-tight text-ink max-sm:[font-size:min(3rem,11.25vw)]">
				Concentration, <span class="italic text-accent">on purpose.</span>
			</h1>
			<p class="mt-7 t-body leading-relaxed text-body">
				This is my taxable brokerage book and crypto: the aggressive half of a barbell,
				where the other half is a fully indexed retirement account I never touch. Every
				position maps to a thesis vector or it is marked for exit. Percentages and prices
				only: no dollar values, no share counts, no advice.
			</p>
		</div>

		<!-- Performance and allocation in one band: the stat tile at left, the
		     donut and legend at right, stacked on compact. The two live elements on
		     the page sit together. Status colour always ships with an explicit sign
		     so it never depends on hue alone. -->
		<section id="performance" class="reveal reveal-2 mt-12 border-t border-line pt-10">
			<h2 id="perf-heading" class="font-serif t-title2 font-medium tracking-tight text-ink">
				Book performance
			</h2>
			<div class="mt-6 grid items-start gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)]">
				<div>
					<!-- Deliberately not "today": outside market hours the figure is the last
					     session's close, and the label beside the number says which. Empty
					     state is faint on purpose: a full-weight dash at this size reads as a
					     redaction bar rather than "no data yet". JS sets the value and colour
					     once /prices.json resolves. -->
					<p class="flex items-baseline gap-x-3">
						<span
							id="day-change"
							class="font-sans text-5xl font-medium tabular-nums leading-none text-muted/30"
							>–</span
						>
						<span id="day-change-label" class="font-mono t-footnote text-muted"
							>awaiting live prices</span
						>
					</p>
					<p class="mt-3 max-w-xs font-mono t-caption leading-relaxed text-muted">
						Allocation-weighted move across every position below, measured against the
						previous close. A percentage of the book, not a dollar figure.
					</p>
					<p id="price-asof" class="mt-3 font-mono t-caption text-muted">
						Allocation as of {asOf}
					</p>
				</div>
				<div id="allocation">
					<h3 class="font-serif t-title3 text-ink">Allocation by thesis vector</h3>
					<div class="mt-5">
						<AllocationDonut />
					</div>
					<p class="mt-5 max-w-2xl t-subhead text-body">
						Eighteen positions grouped into six vectors. Grouped rather than sliced per-ticker
						because eighteen slices is an unreadable chart; the exact per-asset percentages are
						in the table below.
					</p>
				</div>
			</div>
		</section>

		<!-- The thesis behind each vector - the actual point of the page -->
		<section id="theses" class="mt-10 border-t border-line pt-10">
			<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">The theses</h2>
			<div class="mt-5 grid max-w-4xl gap-x-10 gap-y-7 sm:grid-cols-2">
				{
					byVector.map((v) => (
						<article>
							<div class="flex items-baseline gap-x-2.5">
								<span
									class={`mt-1.5 h-2.5 w-2.5 shrink-0 rounded-sm series-bg-${v.slot}`}
									aria-hidden="true"
								/>
								<h3 class="font-serif t-title3 font-medium text-ink">{v.label}</h3>
								<span
									data-thesis-weight={v.id}
									class="font-mono t-caption tabular-nums text-muted">
									{v.weight.toFixed(1)}%
								</span>
							</div>
							<p class="mt-2 t-subhead leading-relaxed text-body">{v.thesis}</p>
							<p class="mt-2 font-mono t-caption text-faint">{tickerLine(v.holdings)}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- Holdings table. This is also the contrast-relief channel the palette
		     validator requires, and the place the per-asset percentages live. -->
		<section id="positions" class="mt-10 border-t border-line pt-10">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
				<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">
					Positions · live prices
				</h2>
				<p class="font-mono t-caption text-muted">
					Allocation, price and daily move only, never values or share counts
				</p>
			</div>

			<div class="mt-6 overflow-x-auto">
				<table class="w-full border-collapse text-left sm:min-w-[36rem]">
					<!-- Below sm each row restacks into a three-column grid (asset / price /
					     move) and the header row leaves the screen. The numbers describe
					     themselves there: a percentage, a dollar price, a signed move. -->
					<thead class="max-sm:sr-only">
						<tr class="border-b border-line font-mono t-caption uppercase tracking-wider text-muted">
							<th scope="col" class="py-2.5 pr-4 font-medium">Asset</th>
							<th scope="col" class="py-2.5 pr-4 font-medium">Vector</th>
							<th scope="col" class="py-2.5 pr-4 text-right font-medium">Weight</th>
							<th scope="col" class="py-2.5 pr-4 text-right font-medium">Price</th>
							<th scope="col" class="py-2.5 text-right font-medium">Today</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-line">
						{
							sorted.map((h) => (
								<tr data-row={h.ticker} class="align-top max-sm:grid max-sm:grid-cols-[1fr_auto_auto] max-sm:gap-x-4 max-sm:gap-y-2 max-sm:py-3">
									<td class="py-3 pr-4 max-sm:col-start-1 max-sm:row-start-1 max-sm:p-0">
										<span class="font-mono t-footnote font-medium text-ink">{h.ticker}</span>{' '}
										<span class="ml-2 t-footnote text-muted">{h.name}</span>
										{h.note && (
											<p class="mt-1 max-w-sm t-caption leading-relaxed text-faint">
												{h.note}
											</p>
										)}
									</td>
									<td class="py-3 pr-4 whitespace-nowrap max-sm:col-start-1 max-sm:row-start-2 max-sm:self-center max-sm:whitespace-normal max-sm:p-0">
										<span class="flex flex-wrap items-center gap-x-2">
											<span
												class={`h-2 w-2 shrink-0 rounded-sm series-bg-${slotOf(h.vector)}`}
												aria-hidden="true"
											/>
											<span class="font-mono t-caption text-muted">{labelOf(h.vector)}</span>
											{h.layer && (
												<span class="font-mono t-caption text-faint">· {layerLabel(h.layer)}</span>
											)}
										</span>
									</td>
									<td
										data-weight={h.ticker}
										class="py-3 pr-4 text-right font-mono t-footnote tabular-nums text-ink max-sm:col-start-3 max-sm:row-start-1 max-sm:p-0">
										{h.weight.toFixed(2)}%
									</td>
									<td
										data-price={h.ticker}
										class="py-3 pr-4 text-right font-mono t-footnote tabular-nums text-muted max-sm:col-start-2 max-sm:row-start-2 max-sm:self-center max-sm:p-0">
										–
									</td>
									<td
										data-change={h.ticker}
										class="py-3 text-right font-mono t-footnote tabular-nums text-muted max-sm:col-start-3 max-sm:row-start-2 max-sm:self-center max-sm:p-0">
										–
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p id="price-note" class="mt-4 font-mono t-caption leading-relaxed text-muted">
				Prices refresh on the Mac mini that serves this page and are published same-origin;
				no third-party script runs in your browser.
			</p>
		</section>

		<!-- Watchlist. Currently the held book, which is where Alec asked to start;
		     the `held` marker is what keeps the section honest rather than implying
		     these are un-owned. Watch-only names added to `watching` in the data
		     module render here with no marker. -->
		<section id="watchlist" class="mt-10 border-t border-line pt-10">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
				<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">Watchlist</h2>
				<p class="font-mono t-caption text-muted">
					{watchlist().filter((w) => !w.held).length === 0
						? 'Everything I hold, tracked in one place'
						: 'Held and watch-only, tracked together'}
				</p>
			</div>
			<ul class="mt-6 grid gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-3">
				{
					watchlist().map((w) => (
						<li
							data-watch={w.ticker}
							class="flex items-baseline justify-between gap-x-3 border-b border-line py-2.5">
							<!-- Badge marks the exception, not the rule. Everything here is held
							     today, so badging all 19 would be pure noise; watch-only names get
							     the marker instead, and the section header states the default. -->
							<span class="flex min-w-0 items-baseline gap-x-2">
								<span class="font-mono t-footnote font-medium text-ink">{w.ticker}</span>
								{!w.held && (
									<span
										class="shrink-0 rounded border border-accent/40 px-1 py-px font-mono t-caption uppercase tracking-wider text-accent"
										title="Watching, no position">
										watching
									</span>
								)}
							</span>
							<span class="flex shrink-0 items-baseline gap-x-3 font-mono t-caption tabular-nums">
								<span data-watch-price={w.ticker} class="text-muted">–</span>
								<span data-watch-change={w.ticker} class="w-14 text-right text-muted">–</span>
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Principles -->
		<section id="rules" class="mt-10 border-t border-line pt-10">
			<h2 class="font-serif t-title2 font-medium tracking-tight text-ink">The rules</h2>
			<ol class="mt-4 max-w-2xl divide-y divide-line">
				{
					principles.map((p, i) => (
						<li class="grid gap-x-5 py-4 sm:grid-cols-[2rem_1fr]">
							<span class="font-mono t-caption tabular-nums text-muted">
								{String(i + 1).padStart(2, '0')}
							</span>
							<div>
								<p class="font-serif t-body font-medium text-ink">{p.rule}</p>
								<p class="mt-1.5 t-subhead leading-relaxed text-body">{p.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<p class="mt-12 max-w-2xl border-t border-line pt-6 font-mono t-caption leading-relaxed text-muted">
			Not financial advice, and not a recommendation to buy or sell anything. This page
			documents my own reasoning on my own money, including the parts of it that are not
			working. Positions change; this page may lag them.
		</p>
		</div>
		<PageNav items={onThisPage} />
	</main>
</Base>

<script>
	// Live prices from /prices.json - same-origin, written by a scheduled job on the
	// host. Progressive enhancement: without it the table shows em-dashes and the
	// server-rendered baseline weights, which is a coherent page on its own.
	// Fetch, freshness guard and formatters live in the shared module so this page,
	// the donut and the home BookChip apply one contract.
	import { closeDay, loadFreshPrices, nf, signed } from '../lib/prices-client';

	function paint(el: HTMLElement | null, n: number) {
		if (!el) return;
		el.textContent = signed(n);
		// Sign is in the text, so colour is reinforcement rather than the only cue.
		el.style.color = n >= 0 ? 'var(--viz-good)' : 'var(--viz-bad)';
	}

	async function load() {
		const fresh = await loadFreshPrices();
		if (!fresh) return;
		const { data, generatedAt, closesAt } = fresh;

		// Headline: allocation-weighted move for the whole book.
		const day = data.portfolio?.dayChangePct;
		if (typeof day === 'number') {
			const el = document.getElementById('day-change');
			if (el) {
				el.textContent = signed(day);
				// Drop the faint empty-state class before applying the status colour.
				el.classList.remove('text-muted/30');
				el.style.color = day >= 0 ? 'var(--viz-good)' : 'var(--viz-bad)';
			}
			// "today" is only true while the market is open; once it closes the figure
			// is the last completed session, and on a weekend that is days old. Name
			// the session when the feed dates it, so a stale close is visibly stale.
			const lab = document.getElementById('day-change-label');
			if (lab) {
				const open = data.marketState === 'market open';
				const dir = day >= 0 ? '▲ up' : '▼ down';
				lab.textContent = open
					? `${dir} today`
					: closesAt
						? `${dir} · ${closeDay(closesAt)} close`
						: `${dir} · last close`;
			}
		}

		// Per-position price, daily move, and live weight.
		for (const [ticker, q] of Object.entries(data.quotes ?? {})) {
			if (typeof q.price === 'number') {
				const el = document.querySelector<HTMLElement>(`[data-price="${ticker}"]`);
				// Sub-dollar assets (DOGE) need more precision than equities.
				if (el) el.textContent = `$${nf(q.price, q.price < 1 ? 4 : 2)}`;
			}
			if (typeof q.changePct === 'number') {
				paint(document.querySelector<HTMLElement>(`[data-change="${ticker}"]`), q.changePct);
			}
			if (typeof q.weight === 'number') {
				const el = document.querySelector<HTMLElement>(`[data-weight="${ticker}"]`);
				if (el) el.textContent = `${nf(q.weight)}%`;
			}
			// Watchlist grid mirrors the same quotes - held and watch-only alike.
			if (typeof q.price === 'number') {
				const el = document.querySelector<HTMLElement>(`[data-watch-price="${ticker}"]`);
				if (el) el.textContent = `$${nf(q.price, q.price < 1 ? 4 : 2)}`;
			}
			if (typeof q.changePct === 'number') {
				paint(document.querySelector<HTMLElement>(`[data-watch-change="${ticker}"]`), q.changePct);
			}
		}

		// The theses cards show the same per-vector weight as the donut legend -
		// keep them on the same live number rather than the static baseline, so
		// the two never disagree on screen (2026-08-21 QA report, B1).
		for (const [id, weight] of Object.entries(data.vectors ?? {})) {
			const el = document.querySelector<HTMLElement>(`[data-thesis-weight="${id}"]`);
			if (el) el.textContent = `${nf(weight, 1)}%`;
		}

		const asof = document.getElementById('price-asof');
		if (asof) {
			// Say "checked" rather than "live" when the market is shut - the prices are
			// real but they are the last close, not a live tick. Date the close itself:
			// "checked 7:35 PM" alone looked fresh for six sessions in Aug 2026 while
			// the numbers underneath were a week old.
			asof.textContent =
				data.marketState === 'market open'
					? `Live · updated ${generatedAt.toLocaleTimeString()}`
					: closesAt
						? `Market closed · ${closeDay(closesAt)} close, checked ${generatedAt.toLocaleTimeString()}`
						: `Market closed · last close, checked ${generatedAt.toLocaleTimeString()}`;
		}
	}

	load();
</script>
