---
import Base from '../layouts/Base.astro';
import PageNav from '../components/PageNav.astro';

const title = 'Uses · hardware and tools';
const description = 'The hardware, software, and infrastructure Alec Layton uses to build and ship.';

const sections: { id: string; heading: string; items: { name: string; note: string }[] }[] = [
	{
		id: 'home-server',
		heading: 'Home server',
		items: [
			{ name: 'Apple M4 Mac mini · 16 GB', note: 'Runs 24/7: serves this site, hosts Kowalski, and does the security rounds at night.' },
			{ name: 'Caddy + Cloudflare Tunnel', note: 'Loopback web server behind an outbound-only tunnel. Zero open ports.' },
			{ name: 'launchd everything', note: 'Deploy poller, health checks, log rotation: cron jobs with a macOS accent.' },
		],
	},
	{
		id: 'building',
		heading: 'Building',
		items: [
			{ name: 'Claude Code + Kowalski', note: 'An autonomous agent does the shipping; I do the deciding. Pull requests are the contract.' },
			{ name: 'Astro + Tailwind v4', note: 'This site: static output, semantic tokens, ~0 JS by default.' },
			{ name: 'Tauri 2 + Rust · React 19 · FastAPI', note: 'The AI Gaming Assistant stack: a desktop app in megabytes, not hundreds of them.' },
			{ name: 'TypeScript, strict', note: 'Non-negotiable. The compiler is the cheapest reviewer I employ.' },
		],
	},
	{
		id: 'day-to-day',
		heading: 'Day to day',
		items: [
			{ name: 'C# / .NET · Python · SQL', note: 'The payroll-engine toolkit at Paycom: compliance controls, ETL pipelines, tax APIs.' },
			{ name: 'Git, PR-first', note: 'Everything lands through a reviewed pull request, even when the author is an AI.' },
		],
	},
];
---

<Base title={title} description={description}>
	<main id="main-content" tabindex="-1" class="flex flex-1 flex-col py-16 lg:grid lg:grid-cols-[minmax(0,1fr)_10rem] lg:gap-x-16">
		<div class="min-w-0">
		<div class="reveal max-w-2xl">
			<p class="font-mono t-footnote uppercase tracking-[0.2em] text-muted">Uses</p>
			<!-- Quiet title, same reasoning as /now. -->
			<h1 class="mt-5 font-serif text-4xl font-medium leading-[0.98] tracking-tight text-ink sm:text-5xl text-display-serif">
				Tools of the trade.
			</h1>
			<p class="mt-7 font-mono t-footnote text-muted">The <a href="https://uses.tech" class="link underline decoration-line underline-offset-4">/uses</a> convention · what's behind the work</p>
		</div>

		{sections.map((s) => (
			<section id={s.id} class="reveal reveal-2 mt-14">
				<h2 class="font-serif text-2xl font-medium tracking-tight text-ink">{s.heading}</h2>
				<ul class="mt-4 max-w-2xl divide-y divide-line">
					{s.items.map((i) => (
						<li class="grid gap-x-6 py-4 sm:grid-cols-[14rem_1fr]">
							<h3 class="font-mono t-footnote font-medium text-ink">{i.name}</h3>
							<p class="mt-1 t-subhead leading-relaxed text-body sm:mt-0">{i.note}</p>
						</li>
					))}
				</ul>
			</section>
		))}
		</div>
		<PageNav items={sections.map((s) => ({ href: `#${s.id}`, label: s.heading }))} />
	</main>
</Base>
