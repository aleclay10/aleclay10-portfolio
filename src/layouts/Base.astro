---
import '../styles/global.css';
import UptimeChip from '../components/UptimeChip.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
// One list, rendered twice (desktop bar + mobile panel) so they cannot drift apart.
const nav = [
	{ href: '/#timeline', label: 'Timeline' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/gaming-assistant', label: 'Gaming Assistant' },
	{ href: '/investing', label: '/investing' },
	{ href: '/stack', label: '/stack' },
	{ href: '/now', label: '/now' },
	{ href: '/uses', label: '/uses' },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Alec Layton" />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>

		<!-- Open Graph / social cards -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alec Layton" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Alec Layton — I build autonomous agent systems" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Browser chrome color -->
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f4" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0d" />
		<!-- Set theme before paint to avoid a flash. External + blocking on purpose:
		     the production CSP (default-src 'self', no unsafe-inline for scripts)
		     silently kills inline scripts — do not switch these back to is:inline. -->
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased selection:bg-accent-soft">
		<div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 sm:px-10">
			<!-- Top bar -->
			<header class="py-6">
				<div class="flex items-center justify-between">
					<a href="/" class="font-mono text-sm font-medium tracking-tight text-ink">
						AL<span class="text-accent">.</span>
					</a>
					<nav aria-label="Site" class="hidden items-center gap-x-7 font-mono text-[13px] text-muted sm:flex">
						{nav.map((n) => <a class="link" href={n.href}>{n.label}</a>)}
					</nav>
					<div class="flex items-center gap-x-3">
						<button id="cmdk" type="button" aria-label="Search"
							class="hidden items-center rounded-md border border-line px-2.5 py-1.5 font-mono text-[12px] text-muted transition hover:border-accent hover:text-ink sm:flex">
							<span>Search</span>
						</button>
						<button id="theme-toggle" type="button" aria-label="Toggle theme"
							class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink">
							<svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
							<svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
						</button>
						<!-- Mobile only: the bar above collapses below sm, so without this the
						     nav and search are both unreachable on a phone (no keyboard, no Cmd-K). -->
						<button id="nav-toggle" type="button" aria-label="Open menu"
							aria-expanded="false" aria-controls="mobile-nav"
							class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink sm:hidden">
							<svg id="nav-icon-open" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
							<svg id="nav-icon-close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
						</button>
					</div>
				</div>

				<nav id="mobile-nav" hidden aria-label="Site"
					class="mt-4 flex flex-col divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface/40 font-mono text-[13px] sm:hidden">
					{nav.map((n) => (
						<a class="px-4 py-3 text-muted transition hover:bg-surface hover:text-accent" href={n.href}>{n.label}</a>
					))}
					<button id="cmdk-mobile" type="button"
						class="px-4 py-3 text-left text-muted transition hover:bg-surface hover:text-accent">Search</button>
				</nav>
			</header>

			<slot />

			<!-- Footer -->
			<footer class="flex flex-wrap items-center justify-between gap-y-3 border-t border-line py-8 font-mono text-[12px] text-muted">
				<span class="flex items-center gap-x-4">
					<span>© 2026 Alec Layton</span>
					<a class="link" href="/resume">Résumé</a>
				</span>
				<UptimeChip />
			</footer>
		</div>

		<!-- ⌘K command palette -->
		<div id="palette" hidden role="dialog" aria-modal="true" aria-label="Search"
			class="fixed inset-0 z-50 bg-canvas/60 backdrop-blur-sm">
			<div class="mx-auto mt-24 w-[calc(100%-2rem)] max-w-lg overflow-hidden rounded-xl border border-line bg-canvas shadow-xl">
				<input id="palette-input" type="text" placeholder="Search pages…" autocomplete="off" spellcheck="false"
					class="w-full border-b border-line bg-transparent px-4 py-3.5 font-mono text-[14px] text-ink placeholder:text-muted focus:outline-none" />
				<ul id="palette-results" class="max-h-80 divide-y divide-line overflow-y-auto"></ul>
			</div>
		</div>

		<script>
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const dark = document.documentElement.classList.toggle('dark');
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			});

			// Mobile disclosure nav. Bundled (not is:inline) — the production CSP blocks inline scripts.
			const navToggle = document.getElementById('nav-toggle');
			const mobileNav = document.getElementById('mobile-nav') as HTMLElement | null;
			const navIconOpen = document.getElementById('nav-icon-open');
			const navIconClose = document.getElementById('nav-icon-close');

			function setNav(open: boolean) {
				if (!mobileNav || !navToggle) return;
				mobileNav.hidden = !open;
				navToggle.setAttribute('aria-expanded', String(open));
				navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
				navIconOpen?.classList.toggle('hidden', open);
				navIconClose?.classList.toggle('hidden', !open);
			}

			navToggle?.addEventListener('click', () => setNav(mobileNav?.hidden !== false));

			// Same-page anchors (/#timeline) do not reload, so the panel has to close itself.
			mobileNav?.addEventListener('click', (e) => {
				if ((e.target as HTMLElement).closest('a, button')) setNav(false);
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') setNav(false);
			});

			// Rotating to landscape can cross the sm breakpoint, which would hide the panel
			// via CSS while it is still logically open and the button still says "Close".
			matchMedia('(min-width: 640px)').addEventListener('change', (e) => {
				if (e.matches) setNav(false);
			});
		</script>
		<!-- Bundled (not is:inline): the production CSP blocks inline scripts.
		     Pagefind's JS/index only exist after a production build (`npm run build`)
		     — in `astro dev` the palette opens but reports search as unavailable. -->
		<script>
			type Result = { url: string; excerpt: string; meta?: { title?: string } };

			const palette = document.getElementById('palette') as HTMLElement | null;
			const input = document.getElementById('palette-input') as HTMLInputElement | null;
			const results = document.getElementById('palette-results') as HTMLElement | null;
			let pagefind: any = null;
			let pagefindFailed = false;
			let items: Result[] = [];
			let active = -1;

			function close() {
				if (palette) palette.hidden = true;
			}

			async function open() {
				if (!palette || !input) return;
				palette.hidden = false;
				input.value = '';
				renderMessage('Type to search…');
				input.focus();
				if (!pagefind && !pagefindFailed) {
					try {
						// Opaque specifier: the index only exists in production builds, so
						// keep TS/Rollup from trying to resolve it at build time.
						const pagefindUrl = '/pagefind/pagefind.js';
						pagefind = await import(/* @vite-ignore */ pagefindUrl);
						await pagefind.init();
					} catch {
						pagefindFailed = true;
						renderMessage('Search index unavailable — production builds only.');
					}
				}
			}

			function renderMessage(msg: string) {
				if (!results) return;
				items = [];
				active = -1;
				results.innerHTML = '';
				const li = document.createElement('li');
				li.className = 'px-4 py-3 font-mono text-[12px] text-muted';
				li.textContent = msg;
				results.append(li);
			}

			function render() {
				if (!results) return;
				results.innerHTML = '';
				if (!items.length) {
					renderMessage('No results.');
					return;
				}
				items.forEach((d, i) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = d.url;
					a.className = 'block px-4 py-3 transition hover:bg-surface' + (i === active ? ' bg-surface' : '');
					const t = document.createElement('p');
					t.className = 'font-serif text-[15px] text-ink';
					t.textContent = d.meta?.title ?? d.url;
					const e = document.createElement('p');
					e.className = 'mt-0.5 text-[12px] leading-relaxed text-muted';
					e.innerHTML = d.excerpt; // our own indexed content
					a.append(t, e);
					li.append(a);
					results.append(li);
				});
			}

			input?.addEventListener('input', async () => {
				const q = input.value.trim();
				if (!pagefind || !q) {
					renderMessage(q ? 'Search index unavailable — production builds only.' : 'Type to search…');
					return;
				}
				const search = await pagefind.debouncedSearch(q);
				if (!search) return; // superseded by newer keystroke
				items = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
				active = items.length ? 0 : -1;
				render();
			});

			document.getElementById('cmdk')?.addEventListener('click', open);
			document.getElementById('cmdk-mobile')?.addEventListener('click', open);
			document.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
					e.preventDefault();
					palette?.hidden ? open() : close();
				} else if (e.key === 'Escape') {
					close();
				} else if (palette && !palette.hidden && items.length) {
					if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
						e.preventDefault();
						active = (active + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
						render();
					} else if (e.key === 'Enter' && active >= 0) {
						window.location.href = items[active].url;
					}
				}
			});
			palette?.addEventListener('click', (e) => {
				if (e.target === palette) close();
			});
		</script>
	</body>
</html>
