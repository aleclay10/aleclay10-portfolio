---
import Base from '../layouts/Base.astro';

const title = '/uses — hardware & tools';
const description = 'The hardware, software, and infrastructure Alec Layton uses to build and ship.';

const sections: { heading: string; items: { name: string; note: string }[] }[] = [
	{
		heading: 'Home server',
		items: [
			{ name: 'Apple M4 Mac mini · 16 GB', note: 'Runs 24/7 — serves this site, hosts Kowalski, and does the security rounds at night.' },
			{ name: 'Caddy + Cloudflare Tunnel', note: 'Loopback web server behind an outbound-only tunnel. Zero open ports.' },
			{ name: 'launchd everything', note: 'Deploy poller, health checks, log rotation — cron jobs with a macOS accent.' },
		],
	},
	{
		heading: 'Building',
		items: [
			{ name: 'Claude Code + Kowalski', note: 'An autonomous agent does the shipping; I do the deciding. Pull requests are the contract.' },
			{ name: 'Astro + Tailwind v4', note: 'This site — static output, semantic tokens, ~0 JS by default.' },
			{ name: 'Tauri 2 + Rust · React 19 · FastAPI', note: 'The AI Gaming Assistant stack — desktop app in megabytes, not hundreds of them.' },
			{ name: 'TypeScript, strict', note: 'Non-negotiable. The compiler is the cheapest reviewer I employ.' },
		],
	},
	{
		heading: 'Day to day',
		items: [
			{ name: 'C# / .NET · Python · SQL', note: 'The payroll-engine toolkit at Paycom — compliance controls, ETL pipelines, tax APIs.' },
			{ name: 'Git, PR-first', note: 'Everything lands through a reviewed pull request — even when the author is an AI.' },
		],
	},
];
---

<Base title={title} description={description}>
	<main class="flex flex-1 flex-col py-16">
		<div class="reveal max-w-2xl">
			<p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">Uses</p>
			<h1 class="mt-5 font-serif text-5xl font-medium leading-[0.98] tracking-tight text-ink sm:text-6xl"
				style="font-optical-sizing: auto;">
				Tools of <span class="italic text-accent">the trade.</span>
			</h1>
			<p class="mt-7 font-mono text-[13px] text-muted">The <a href="https://uses.tech" class="link underline decoration-line underline-offset-4">/uses</a> convention · what's behind the work</p>
		</div>

		{sections.map((s) => (
			<section class="reveal reveal-2 mt-14">
				<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">{s.heading}</p>
				<ul class="mt-6 max-w-2xl divide-y divide-line">
					{s.items.map((i) => (
						<li class="grid gap-x-6 py-4 sm:grid-cols-[14rem_1fr]">
							<h2 class="font-mono text-[13px] font-medium text-ink">{i.name}</h2>
							<p class="mt-1 text-[14px] leading-relaxed text-muted sm:mt-0">{i.note}</p>
						</li>
					))}
				</ul>
			</section>
		))}
	</main>
</Base>
