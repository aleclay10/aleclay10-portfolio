---
import { existsSync } from 'node:fs';
import path from 'node:path';

import '../styles/global.css';
import UptimeChip from '../components/UptimeChip.astro';

interface Props {
	title: string;
	description: string;
	/** Keep a page out of search engines. For utility pages (form confirmations and
	 *  the like) that are real routes but have no business ranking for anything. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// One list, rendered twice (desktop bar + mobile panel) so they cannot drift apart.
const nav = [
	{ href: '/#timeline', label: 'Timeline' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/gaming-assistant/', label: 'Gaming Assistant' },
	{ href: '/investing/', label: '/investing' },
	{ href: '/stack/', label: '/stack' },
	{ href: '/now/', label: '/now' },
	{ href: '/uses/', label: '/uses' },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Per-page social card. Generated by `npm run og` and committed to public/og/ -
// deliberately not built here, see the header of scripts/build-og-images.mjs.
// Slug derivation must match slugOf() in that script.
// Resolved from process.cwd() (the project root - npm sets it to the package.json
// directory) rather than import.meta.url: an .astro module is compiled before it
// runs, so import.meta.url points into the build output, not src/layouts/.
const slug = Astro.url.pathname.replace(/^\/+|\/+$/g, '').replace(/\//g, '-') || 'home';
const hasCard = existsSync(path.resolve(process.cwd(), 'public/og', `${slug}.png`));

// Warn rather than fail: a missing card is a forgotten `npm run og`, not a
// reason to abort a build and freeze the live site at the next signed tag. The
// generic card still ships, so the page degrades to what it had before.
if (!hasCard) {
	console.warn(`[og] no card for ${Astro.url.pathname} (public/og/${slug}.png) - run \`npm run og\`. Falling back to /og.png.`);
}

const ogImage = new URL(hasCard ? `/og/${slug}.png` : '/og.png', Astro.site).href;
// The old value was hardcoded to the homepage tagline and so was wrong on seven
// of eight pages - an accessibility string that described the wrong image.
const ogImageAlt = hasCard ? title : 'Alec Layton: I build autonomous agent systems';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Alec Layton" />
		{/* A noindex page has no canonical URL to declare. /404 in particular resolved
		     its canonical to https://aleclay10.dev/404/ - a URL that itself 404s - which
		     is worse than having no tag at all. */}
		{!noindex && <link rel="canonical" href={canonical} />}
		<title>{title}</title>

		<!-- Open Graph / social cards -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alec Layton" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Browser chrome color -->
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8f4" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c0d" />
		<!-- Set theme before paint to avoid a flash. External + blocking on purpose:
		     the production CSP (default-src 'self', no unsafe-inline for scripts)
		     silently kills inline scripts - do not switch these back to is:inline. -->
		<script is:inline src="/theme-init.js"></script>
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased selection:bg-accent-soft">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-[13px] focus:font-medium focus:text-canvas">
			Skip to content
		</a>
		<div class="mx-auto flex min-h-screen max-w-5xl flex-col px-6 sm:px-10">
			<!-- Top bar. data-vt-header is the view-transition hook (global.css) -
			     it holds the header steady instead of cross-fading it with itself. -->
			<header data-vt-header class="py-6">
				<div class="flex items-center justify-between">
					<a href="/" class="font-mono text-sm font-medium tracking-tight text-ink">
						AL<span class="text-accent">.</span>
					</a>
					<nav aria-label="Site" class="hidden items-center gap-x-7 font-mono text-[13px] text-muted sm:flex">
						{nav.map((n) => <a class="link" href={n.href}>{n.label}</a>)}
					</nav>
					<div class="flex items-center gap-x-3">
						<button id="cmdk" type="button" aria-label="Search"
							class="hidden items-center rounded-md border border-line px-2.5 py-1.5 font-mono text-[12px] text-muted transition hover:border-accent hover:text-ink sm:flex">
							<span>Search</span>
						</button>
						<!-- aria-label is a placeholder: the script below rewrites it on load to
						     name the theme this button switches *to*, because the active theme is
						     set by theme-init.js before paint and is conveyed only by an icon
						     swap. A static "Toggle theme" told a screen-reader user nothing about
						     which theme they were currently in. -->
						<button id="theme-toggle" type="button" aria-label="Switch theme"
							class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink">
							<svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
							<svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
						</button>
						<!-- Mobile only: the bar above collapses below sm, so without this the
						     nav and search are both unreachable on a phone (no keyboard, no Cmd-K). -->
						<button id="nav-toggle" type="button" aria-label="Open menu"
							aria-expanded="false" aria-controls="mobile-nav"
							class="rounded-md border border-line p-2 text-muted transition hover:border-accent hover:text-ink sm:hidden">
							<svg id="nav-icon-open" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
							<svg id="nav-icon-close" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
						</button>
					</div>
				</div>

				<nav id="mobile-nav" hidden aria-label="Site"
					class="mt-4 flex flex-col divide-y divide-line overflow-hidden rounded-lg border border-line bg-surface/40 font-mono text-[13px] sm:hidden">
					{nav.map((n) => (
						<a class="px-4 py-3 text-muted transition hover:bg-surface hover:text-accent" href={n.href}>{n.label}</a>
					))}
					<button id="cmdk-mobile" type="button"
						class="px-4 py-3 text-left text-muted transition hover:bg-surface hover:text-accent">Search</button>
				</nav>
			</header>

			<slot />

			<!-- Footer -->
			<footer class="flex flex-wrap items-center justify-between gap-y-3 border-t border-line py-8 font-mono text-[12px] text-muted">
				<span class="flex items-center gap-x-4">
					<span>© 2026 Alec Layton</span>
					<a class="link" href="/resume/">Résumé</a>
				</span>
				<UptimeChip />
			</footer>
		</div>

		<!-- ⌘K find-in-files palette. Keep the id `palette`: global.css:147 hides it
		     from print, which is what keeps it out of the generated resume.pdf. -->
		<div id="palette" hidden role="dialog" aria-modal="true" aria-label="Search"
			class="fixed inset-0 z-50 bg-canvas/60 backdrop-blur-sm">
			<div class="mx-auto mt-16 w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-xl border border-line bg-canvas shadow-xl sm:mt-24">
				<input id="palette-input" type="text" placeholder="Find in pages…" autocomplete="off" spellcheck="false"
					role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list"
					class="w-full border-b border-line bg-transparent px-4 py-3.5 font-mono text-[14px] text-ink placeholder:text-muted focus:outline-none" />
				<div id="palette-results" role="listbox" aria-label="Search results"
					class="max-h-[60vh] overflow-y-auto overscroll-contain"></div>
				<div id="palette-status" aria-live="polite"
					class="flex items-center border-t border-line px-4 py-2 font-mono text-[11px] text-muted"></div>
			</div>
		</div>

		<script>
			const themeToggle = document.getElementById('theme-toggle');

			// Name the button after the theme it switches *to*, and keep that in step with
			// the class theme-init.js already applied before this script ran.
			function syncThemeLabel() {
				const dark = document.documentElement.classList.contains('dark');
				themeToggle?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
			}
			syncThemeLabel();

			themeToggle?.addEventListener('click', () => {
				const dark = document.documentElement.classList.toggle('dark');
				try {
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				} catch {
					// Storage blocked or full. The toggle already applied above, so the
					// theme still switches for this page view; only persistence is lost.
					// An uncaught throw here would also skip syncThemeLabel() below and
					// leave the button announcing the wrong direction.
				}
				syncThemeLabel();
			});

			// Mobile disclosure nav. Bundled (not is:inline) - the production CSP blocks inline scripts.
			const navToggle = document.getElementById('nav-toggle');
			const mobileNav = document.getElementById('mobile-nav') as HTMLElement | null;
			const navIconOpen = document.getElementById('nav-icon-open');
			const navIconClose = document.getElementById('nav-icon-close');

			function setNav(open: boolean) {
				if (!mobileNav || !navToggle) return;
				mobileNav.hidden = !open;
				navToggle.setAttribute('aria-expanded', String(open));
				navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
				navIconOpen?.classList.toggle('hidden', open);
				navIconClose?.classList.toggle('hidden', !open);
			}

			navToggle?.addEventListener('click', () => setNav(mobileNav?.hidden !== false));

			// Same-page anchors (/#timeline) do not reload, so the panel has to close itself.
			mobileNav?.addEventListener('click', (e) => {
				if ((e.target as HTMLElement).closest('a, button')) setNav(false);
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') setNav(false);
			});

			// Rotating to landscape can cross the sm breakpoint, which would hide the panel
			// via CSS while it is still logically open and the button still says "Close".
			matchMedia('(min-width: 640px)').addEventListener('change', (e) => {
				if (e.matches) setNav(false);
			});
		</script>
		<!-- Bundled (not is:inline): the production CSP blocks inline scripts.
		     Both of these are thin loaders. The palette engine and the arrival
		     highlighter are separate chunks, fetched only on intent - same-origin, so
		     `default-src 'self'` allows them. The palette reads /search-index.json,
		     which only exists after a production build; under `astro dev` it says so,
		     in those words. -->
		<script>
			import '../scripts/search-boot';
		</script>
	</body>
</html>
