---
import Base from '../layouts/Base.astro';

const title = 'AI Gaming Assistant — early access';
const description =
	'A lightweight desktop companion for gamers — AI chat that knows your play history, session tracking across 80+ titles, Discord without alt-tabbing, and notifications smart enough to wait for the respawn screen. Join the early access list.';

// Waitlist form endpoint (Buttondown/Formspree). Empty = fall back to a mailto
// CTA so the page never ships a dead form. Set once Alec creates the account.
const WAITLIST_ACTION = '';

const features = [
	{
		label: 'AI chat that knows your games',
		desc: 'Streamed answers with your play history as context — builds, strats, lore, whatever the session calls for.',
	},
	{
		label: 'Session tracking',
		desc: 'Detects 80+ titles automatically and keeps your play log local-first, synced to the cloud when you want it.',
	},
	{
		label: 'Discord, without alt-tab',
		desc: 'Read and answer DMs from inside the companion — no more dropping out of a match to check your phone.',
	},
	{
		label: 'Content briefings',
		desc: 'Your subreddits, feeds, and channels distilled into a "what you missed" brief between sessions.',
	},
	{
		label: 'Notifications with game sense',
		desc: 'A priority queue that knows when you’re mid-match. Only the urgent breaks through; the rest waits.',
	},
	{
		label: 'Stats & weekly recap',
		desc: 'Playtime across every title you touch, plus an AI-written recap of your week in games.',
	},
];

const engineering = [
	'Tauri 2 + Rust core — megabytes on disk, not an Electron heavyweight',
	'Local-first SQLite; cloud sync is opt-in, with retry and token refresh',
	'Inference chain: Groq → Together AI → your local Ollama, your choice',
	'238 automated tests across Rust, Python, and TypeScript',
];

const tiers = [
	{
		name: 'Free',
		price: '$0',
		cadence: 'forever',
		items: ['50 AI messages a day', 'Session tracking, all titles', 'Discord viewing', 'Content feed & stats'],
	},
	{
		name: 'Pro',
		price: '$2.99',
		cadence: 'per month',
		featured: true,
		items: ['Unlimited AI chat', 'Send & reply on Discord', 'Priority inference', 'Weekly AI recap'],
	},
];
---

<Base title={title} description={description}>
	<main class="flex flex-1 flex-col py-16">
		<!-- Hero -->
		<div class="grid items-center gap-12 sm:grid-cols-[1.5fr_1fr]">
			<div class="reveal max-w-2xl">
				<p class="font-mono text-[13px] uppercase tracking-[0.2em] text-accent">
					Product · Early access
				</p>
				<h1 class="mt-5 font-serif text-5xl font-medium leading-[0.98] tracking-tight text-ink sm:text-6xl"
					style="font-optical-sizing: auto;">
					Game on.<br /><span class="italic text-accent">Phone down.</span>
				</h1>
				<p class="mt-7 text-[17px] leading-relaxed text-muted">
					AI Gaming Assistant is a lightweight desktop companion that lives alongside
					your games — it learns what you play, keeps you connected, and handles
					everything you'd otherwise reach for your phone to do mid-session.
				</p>
				<div class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-3 font-mono text-[13px]">
					<a href="#waitlist" class="rounded-md bg-accent px-4 py-2.5 font-medium text-canvas transition hover:opacity-90">
						Get early access
					</a>{' '}
					<span class="px-2 py-2.5 text-muted">Windows & macOS at launch · free tier included</span>
				</div>
			</div>

			<!-- Stylized app frame (illustrative, not a screenshot) -->
			<div class="reveal reveal-2 hidden justify-self-end sm:block">
				<div class="w-72 overflow-hidden rounded-xl border border-line bg-surface shadow-sm">
					<div class="flex items-center gap-x-1.5 border-b border-line px-3 py-2">
						<span class="h-2 w-2 rounded-full bg-line"></span>
						<span class="h-2 w-2 rounded-full bg-line"></span>
						<span class="h-2 w-2 rounded-full bg-line"></span>
						<span class="ml-2 font-mono text-[10px] text-muted">AI Gaming Assistant</span>
					</div>
					<div class="space-y-3 p-4">
						<div class="flex items-center gap-x-2 font-mono text-[11px] text-muted">
							<span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
							Now playing · detected automatically
						</div>
						<div class="rounded-lg border border-line bg-canvas p-3">
							<p class="font-mono text-[10px] uppercase tracking-wider text-muted">You</p>
							<p class="mt-1 text-[13px] text-ink">best loadout for tonight?</p>
						</div>
						<div class="rounded-lg border border-line bg-canvas p-3">
							<p class="font-mono text-[10px] uppercase tracking-wider text-accent">Assistant</p>
							<p class="mt-1 text-[13px] leading-relaxed text-muted">Based on your last 12 sessions, try…</p>
						</div>
						<div class="flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] text-muted">
							<span>Discord · 2 unread</span>{' '}
							<span>held until match ends</span>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Features -->
		<section class="mt-20 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">What it does</p>
			<div class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
				{features.map((f) => (
					<div class="bg-canvas p-5">
						<h2 class="font-serif text-lg text-ink">{f.label}</h2>
						<p class="mt-2 text-[14px] leading-relaxed text-muted">{f.desc}</p>
					</div>
				))}
			</div>
		</section>

		<!-- Engineering strip -->
		<section class="mt-16 grid gap-10 border-t border-line pt-10 sm:grid-cols-[1fr_1.5fr]">
			<div>
				<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Built like it means it</p>
				<p class="mt-4 max-w-xs text-[14px] leading-relaxed text-muted">
					The same engineering bar as everything else on this site — small,
					fast, local-first, and tested.
				</p>
			</div>
			<ul class="space-y-2.5 font-mono text-[13px] leading-relaxed text-muted sm:mt-1">
				{engineering.map((s) => (
					<li class="flex items-baseline gap-x-2.5">
						<span class="h-1.5 w-1.5 shrink-0 self-center rounded-full bg-accent"></span>
						{s}
					</li>
				))}
			</ul>
		</section>

		<!-- Pricing -->
		<section class="mt-16 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Pricing</p>
			<div class="mt-6 grid gap-5 sm:max-w-2xl sm:grid-cols-2">
				{tiers.map((t) => (
					<div class={`rounded-xl border p-6 ${t.featured ? 'border-accent' : 'border-line'}`}>
						<div class="flex items-baseline justify-between">
							<h2 class="font-serif text-xl text-ink">{t.name}</h2>
							<p class="font-mono text-[13px] text-muted">
								<span class="text-lg font-medium text-ink">{t.price}</span> {t.cadence}
							</p>
						</div>
						<ul class="mt-5 space-y-2.5 text-[14px] leading-relaxed text-muted">
							{t.items.map((i) => (
								<li class="flex items-baseline gap-x-2.5">
									<span class={`h-1.5 w-1.5 shrink-0 self-center rounded-full ${t.featured ? 'bg-accent' : 'bg-line'}`}></span>
									{i}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
			<p class="mt-4 font-mono text-[12px] text-muted">Billing runs in-app through Stripe — no card needed to join the list.</p>
		</section>

		<!-- Privacy -->
		<section class="mt-16 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-muted">Your data</p>
			<p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-muted">
				Local-first by design: your play history lives on your machine and syncs only
				if you opt in. Anything the app collects is consent-based and spelled out at
				onboarding — no dark patterns, no selling data.
			</p>
		</section>

		<!-- Waitlist -->
		<section id="waitlist" class="mt-16 border-t border-line pt-10">
			<p class="font-mono text-[12px] uppercase tracking-[0.2em] text-accent">Early access</p>
			<h2 class="mt-4 font-serif text-3xl text-ink">Be first through the door.</h2>
			<p class="mt-3 max-w-md text-[15px] leading-relaxed text-muted">
				Windows and macOS builds land soon. Join the list and you'll hear the moment
				the doors open — nothing else, no spam.
			</p>
			{WAITLIST_ACTION ? (
				<form method="post" action={WAITLIST_ACTION} class="mt-6 flex max-w-md flex-wrap gap-3">
					<label class="sr-only" for="email">Email address</label>
					<input id="email" type="email" name="email" required placeholder="you@example.com"
						class="min-w-0 flex-1 rounded-md border border-line bg-canvas px-3.5 py-2.5 font-mono text-[13px] text-ink placeholder:text-muted focus:border-accent focus:outline-none" />
					<button type="submit" class="rounded-md bg-accent px-4 py-2.5 font-mono text-[13px] font-medium text-canvas transition hover:opacity-90">
						Join the list
					</button>
				</form>
			) : (
				<a href="mailto:alec.layton100@gmail.com?subject=AI%20Gaming%20Assistant%20%E2%80%94%20early%20access"
					class="mt-6 inline-block rounded-md bg-accent px-4 py-2.5 font-mono text-[13px] font-medium text-canvas transition hover:opacity-90">
					Request early access ↗
				</a>
			)}
		</section>
	</main>
</Base>
